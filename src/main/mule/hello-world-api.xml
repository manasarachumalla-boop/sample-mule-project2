<?xml version="1.0" encoding="UTF-8"?>
<!--
  hello-world-api.xml
  ============================================================
  Main API flows for hello-world-api.

  Endpoint:
    GET /hello  ->  200 { "message": "Hello World from MuleSoft" }

  Flow steps:
    1. HTTP Listener   - accepts incoming GET /hello requests
    2. Logger (INFO)   - logs correlation ID and request path
    3. Set Payload     - builds the JSON response body
    4. Error Handler   - references global named error handler
  ============================================================
-->
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
          https://www.mulesoft.org/schema/mule/core/current
        http://www.mulesoft.org/schema/mule/http
          https://www.mulesoft.org/schema/mule/http/current">

    <!-- ==============================================================
         FLOW: hello-world-get-flow
         Handles: GET /hello
         Returns: 200 { "message": "Hello World from MuleSoft" }
         ============================================================== -->
    <flow name="hello-world-get-flow" doc:id="hello-world-get-flow-001">

        <!-- 1. HTTP Listener: accept GET requests on /hello -->
        <http:listener
            config-ref="HTTP_Listener_config"
            path="/hello"
            allowedMethods="GET"
            doc:name="GET /hello"
            doc:id="listener-001">
            <http:response statusCode="200">
                <http:headers>
                    <!-- Ensure the client receives JSON content type -->
                    <![CDATA[#[{'Content-Type': 'application/json'}]]]>
                </http:headers>
            </http:response>
        </http:listener>

        <!-- 2. Logger: log incoming request with correlation ID -->
        <logger
            doc:name="Log Incoming Request"
            doc:id="logger-001"
            level="INFO"
            message='#["[" ++ correlationId ++ "] GET /hello received from " ++ (attributes.remoteAddress default "unknown")]' />

        <!-- 3. Set Payload: return JSON Hello World response -->
        <set-payload
            doc:name="Build JSON Response"
            doc:id="set-payload-001"
            value='#[output application/json --- { "message": "Hello World from MuleSoft" }]' />

        <!-- 4. Logger: log successful response -->
        <logger
            doc:name="Log Response Sent"
            doc:id="logger-002"
            level="INFO"
            message='#["[" ++ correlationId ++ "] GET /hello responding 200 OK"]' />

        <!-- 5. Flow-level error handler: delegates to global handler -->
        <error-handler ref="globalErrorHandler" doc:name="Global Error Handler" doc:id="error-ref-001" />

    </flow>

</mule>