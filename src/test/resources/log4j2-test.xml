<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1} [TEST] - %m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- Set MUnit logging to DEBUG during test runs for detailed output -->
        <AsyncLogger name="com.mulesoft.munit" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
        </AsyncLogger>
        <AsyncLogger name="org.mule" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </AsyncLogger>
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>