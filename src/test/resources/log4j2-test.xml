<?xml version="1.0" encoding="UTF-8"?>
<!--
  log4j2-test.xml - Test Logging Configuration
  Applied during MUnit test execution.
  More verbose than production to aid test debugging.
-->
<Configuration status="WARN">

    <Appenders>
        <Console name="STDOUT" target="SYSTEM_OUT">
            <PatternLayout pattern="[%-5p] [%t] %c{1} - %m%n" />
        </Console>
    </Appenders>

    <Loggers>

        <!-- Full DEBUG output for application code during tests -->
        <AsyncLogger name="com.mycompany" level="DEBUG" additivity="false">
            <AppenderRef ref="STDOUT" />
        </AsyncLogger>

        <!-- MUnit test runner output -->
        <AsyncLogger name="com.mulesoft.munit" level="INFO" additivity="false">
            <AppenderRef ref="STDOUT" />
        </AsyncLogger>

        <AsyncLogger name="org.mule" level="WARN" additivity="false">
            <AppenderRef ref="STDOUT" />
        </AsyncLogger>

        <AsyncLogger name="com.mulesoft" level="WARN" additivity="false">
            <AppenderRef ref="STDOUT" />
        </AsyncLogger>

        <AsyncRoot level="WARN">
            <AppenderRef ref="STDOUT" />
        </AsyncRoot>

    </Loggers>

</Configuration>