<?xml version="1.0" encoding="UTF-8"?>
<!--
  hello-world-api-test-suite.xml
  MUnit 3.x test suite for hello-world-api flows.

  Test cases:
    1. hello-world-get-flow-success-test   - flow executes and returns payload
    2. hello-world-get-flow-valid-json-test - payload is valid JSON object
-->
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
          https://www.mulesoft.org/schema/mule/core/current
        http://www.mulesoft.org/schema/mule/munit
          https://www.mulesoft.org/schema/mule/munit/current
        http://www.mulesoft.org/schema/mule/munit-tools
          https://www.mulesoft.org/schema/mule/munit-tools/current">

    <!-- Link this suite to the application -->
    <munit:config name="hello-world-api-test-suite.xml" doc:id="munit-config-001" />

    <!-- ================================================================
         TEST 1: Flow executes and returns a non-null payload
         ================================================================ -->
    <munit:test
        name="hello-world-get-flow-success-test"
        doc:id="munit-test-001"
        description="GET /hello flow should return a non-null payload with the greeting message">

        <munit:execution>
            <flow-ref name="hello-world-get-flow" doc:name="Execute hello-world-get-flow" doc:id="flow-ref-001" />
        </munit:execution>

        <munit:validation>
            <!-- Payload must not be null -->
            <munit-tools:assert-that
                doc:name="Assert payload not null"
                doc:id="assert-001"
                expression="#[payload]"
                is="#[MunitTools::notNullValue()]" />

            <!-- Payload must contain the 'message' key -->
            <munit-tools:assert-that
                doc:name="Assert message key present"
                doc:id="assert-002"
                expression="#[payload contains 'message']"
                is="#[MunitTools::equalTo(true)]" />

            <!-- Payload must contain the exact greeting text -->
            <munit-tools:assert-that
                doc:name="Assert greeting value"
                doc:id="assert-003"
                expression="#[payload contains 'Hello World from MuleSoft']"
                is="#[MunitTools::equalTo(true)]" />
        </munit:validation>

    </munit:test>

    <!-- ================================================================
         TEST 2: Payload is a JSON object (starts with '{')
         ================================================================ -->
    <munit:test
        name="hello-world-get-flow-valid-json-test"
        doc:id="munit-test-002"
        description="GET /hello response payload should be a JSON object">

        <munit:execution>
            <flow-ref name="hello-world-get-flow" doc:name="Execute hello-world-get-flow" doc:id="flow-ref-002" />
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                doc:name="Assert JSON object shape"
                doc:id="assert-004"
                expression="#[payload startsWith '{']"
                is="#[MunitTools::equalTo(true)]" />
        </munit:validation>

    </munit:test>

</mule>