<?xml version="1.0" encoding="UTF-8"?>
<!--
  settings.xml — MuleSoft Anypoint Platform Maven Authentication
  ================================================================
  PURPOSE : Authenticates Maven against Anypoint Exchange and MuleSoft
            repositories for dependency resolution, Exchange publishing,
            and CloudHub 2.0 deployment.

  CONNECTED APP FORMAT (Mule Maven Plugin 4.x)
    username: ~~~Client~~~
    password: <clientId>~?~<clientSecret>

  CREATING A CONNECTED APP
    Anypoint Platform > Access Management > Connected Apps > Create
    Required scopes:
      Design Center Developer
      Exchange Contributor / Viewer
      Manage APIs Configuration
      Runtime Manager: Deploy Mule Applications
      CloudHub Network Administrator (Private Space only)

  LOCAL USE
    Replace ANYPOINT_CLIENT_ID and ANYPOINT_CLIENT_SECRET with real values,
    then run:
      mvn deploy -DmuleDeploy -s settings.xml -P deploy-dev
        -DbusinessGroupId=<orgId>
        -DconnectedAppClientId=<clientId>
        -DconnectedAppClientSecret=<clientSecret>
        -Dcloudhub2.environment=Sandbox
        -Dcloudhub2.target=Cloudhub-US-East-2

  CI/CD (GitHub Actions)
    The pipeline generates ~/.m2/settings.xml at runtime from GitHub Secrets.
    This file is a TEMPLATE ONLY — never commit real credentials.

  SECURITY
    Rotate Connected App secrets every 90 days.
    Use minimum required scopes (principle of least privilege).
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              http://maven.apache.org/xsd/settings-1.0.0.xsd">

  <servers>

    <!--
      Anypoint Exchange v3 — artifact publishing and dependency resolution.
      Maps to: pom.xml > distributionManagement > anypoint-exchange-v3
               pom.xml > repositories > anypoint-exchange-v3
    -->
    <server>
      <id>anypoint-exchange-v3</id>
      <username>~~~Client~~~</username>
      <!-- LOCAL ONLY: replace with real values. CI injects these at runtime. -->
      <password>ANYPOINT_CLIENT_ID~?~ANYPOINT_CLIENT_SECRET</password>
    </server>

    <!--
      MuleSoft public releases — resolves Mule connectors and runtime jars.
      Maps to: pom.xml > repositories > mulesoft-releases
               pom.xml > pluginRepositories > mulesoft-releases
    -->
    <server>
      <id>mulesoft-releases</id>
      <username>~~~Client~~~</username>
      <password>ANYPOINT_CLIENT_ID~?~ANYPOINT_CLIENT_SECRET</password>
    </server>

    <!--
      MuleSoft Enterprise repository.
      Uncomment if your project uses EE-licensed connectors (Anypoint MQ,
      DataWeave Enterprise libs, Runtime Fabric dependencies, etc.)
    -->
    <!--
    <server>
      <id>mulesoft-enterprise-repository</id>
      <username>~~~Client~~~</username>
      <password>ANYPOINT_CLIENT_ID~?~ANYPOINT_CLIENT_SECRET</password>
    </server>
    -->

  </servers>

  <!--
    OPTIONAL PROFILE — corporate Maven mirror.
    Uncomment and update the URL to route all artifact resolution through
    your internal Nexus / Artifactory instance.

    <profiles>
      <profile>
        <id>corporate-mirror</id>
        <repositories>
          <repository>
            <id>central-mirror</id>
            <url>https://nexus.mycompany.com/repository/maven-public/</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
          </repository>
        </repositories>
      </profile>
    </profiles>
    <activeProfiles>
      <activeProfile>corporate-mirror</activeProfile>
    </activeProfiles>
  -->

  <!--
    OPTIONAL PROXY — corporate HTTP proxy.
    Uncomment if Maven must route outbound traffic through a proxy server.

    <proxies>
      <proxy>
        <id>corporate-proxy</id>
        <active>true</active>
        <protocol>http</protocol>
        <host>proxy.mycompany.com</host>
        <port>8080</port>
        <nonProxyHosts>localhost|127.0.0.1|*.mycompany.com</nonProxyHosts>
      </proxy>
    </proxies>
  -->

</settings>