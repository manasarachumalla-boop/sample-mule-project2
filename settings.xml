<?xml version="1.0" encoding="UTF-8"?>
<!--
  settings.xml
  ============================================================
  Maven settings file for hello-world-api.

  This file configures:
    1. MuleSoft Enterprise repository credentials
       (required to download Mule connectors and plugins)
    2. Anypoint Exchange repository access

  USAGE:
    mvn clean package -s settings.xml
    mvn deploy -s settings.xml

  CREDENTIAL SOURCES:
    Local development:
      Set environment variables before running Maven:
        export ANYPOINT_CLIENT_ID=<your-client-id>
        export ANYPOINT_CLIENT_SECRET=<your-client-secret>

    GitHub Actions CI/CD:
      Credentials are injected via GitHub Secrets:
        ANYPOINT_CLIENT_ID      -> env.ANYPOINT_CLIENT_ID
        ANYPOINT_CLIENT_SECRET  -> env.ANYPOINT_CLIENT_SECRET

  SECURITY:
    Do NOT hardcode credentials in this file.
    Commit this file to version control - it contains no secrets.
  ============================================================
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
            https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <!-- ==================== Server Credentials ==================== -->
    <servers>

        <!--
          Anypoint Exchange V3
          Used to download API assets and dependencies from Exchange.
          Credentials: Anypoint Connected App (client_credentials)
        -->
        <server>
            <id>anypoint-exchange-v3</id>
            <username>~~~Client~~~</username>
            <password>${env.ANYPOINT_CLIENT_ID}~?~${env.ANYPOINT_CLIENT_SECRET}</password>
        </server>

        <!--
          MuleSoft Enterprise (EE) Repository
          Required for Mule EE runtime, connectors, and MUnit.
          Credentials: same Connected App.
        -->
        <server>
            <id>mulesoft-enterprise-repository</id>
            <username>~~~Client~~~</username>
            <password>${env.ANYPOINT_CLIENT_ID}~?~${env.ANYPOINT_CLIENT_SECRET}</password>
        </server>

    </servers>

    <!-- ==================== Profiles ==================== -->
    <profiles>

        <profile>
            <id>mule-extra-repos</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <repositories>
                <repository>
                    <id>anypoint-exchange-v3</id>
                    <name>Anypoint Exchange V3</name>
                    <url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
                <repository>
                    <id>mulesoft-releases</id>
                    <name>MuleSoft Releases</name>
                    <url>https://repository.mulesoft.org/releases/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>mulesoft-releases</id>
                    <name>MuleSoft Releases Plugin Repository</name>
                    <url>https://repository.mulesoft.org/releases/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>

    </profiles>

</settings>