<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hello World API - MuleSoft 4 Application
  pom.xml: Maven build, dependencies, and CloudHub 2.0 deployment configuration
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ==================== Project Coordinates ==================== -->
    <groupId>com.mycompany</groupId>
    <artifactId>hello-world-api</artifactId>
    <version>1.0.0</version>
    <packaging>mule-application</packaging>
    <name>hello-world-api</name>
    <description>MuleSoft 4 Hello World API with CI/CD to CloudHub 2.0</description>

    <!-- ==================== Global Properties ==================== -->
    <properties>
        <!-- Plugin versions -->
        <mule.maven.plugin.version>4.2.0</mule.maven.plugin.version>
        <munit.version>3.2.0</munit.version>

        <!-- Connector versions -->
        <http.connector.version>1.9.3</http.connector.version>

        <!-- Java -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
          CloudHub 2.0 deployment properties.
          Override at CI/CD time using: mvn deploy -Dapp.name=hello-world-api-feature-xyz
        -->
        <app.name>hello-world-api</app.name>
        <deploy.environment>Sandbox</deploy.environment>
        <deploy.target>Cloudhub-US-East-1</deploy.target>
        <deploy.replica.size>0.1</deploy.replica.size>
        <deploy.replicas>1</deploy.replicas>
        <deploy.runtime.version>4.6.0:1e</deploy.runtime.version>

        <!--
          Anypoint Connected App credentials.
          Injected via GitHub Secrets in CI/CD:
            ANYPOINT_CLIENT_ID  -> anypoint.client.id
            ANYPOINT_CLIENT_SECRET -> anypoint.client.secret
        -->
        <anypoint.client.id>${env.ANYPOINT_CLIENT_ID}</anypoint.client.id>
        <anypoint.client.secret>${env.ANYPOINT_CLIENT_SECRET}</anypoint.client.secret>
    </properties>

    <!-- ==================== Dependency Management ==================== -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.mule.distributions</groupId>
                <artifactId>mule-runtime-impl-bom</artifactId>
                <version>4.6.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ==================== Dependencies ==================== -->
    <dependencies>

        <!-- Mule HTTP Connector - required for HTTP Listener and Request -->
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-http-connector</artifactId>
            <version>${http.connector.version}</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- MUnit Runner - test runtime (test scope only) -->
        <dependency>
            <groupId>com.mulesoft.munit</groupId>
            <artifactId>munit-runner</artifactId>
            <version>${munit.version}</version>
            <classifier>mule-plugin</classifier>
            <scope>test</scope>
        </dependency>

        <!-- MUnit Tools - assertions and mocking (test scope only) -->
        <dependency>
            <groupId>com.mulesoft.munit</groupId>
            <artifactId>munit-tools</artifactId>
            <version>${munit.version}</version>
            <classifier>mule-plugin</classifier>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ==================== Build Plugins ==================== -->
    <build>
        <plugins>

            <!--
              Mule Maven Plugin
              Handles: packaging (mule-application), unit testing, and deployment
              Deploy goal: mvn deploy -DskipTests -Dapp.name=hello-world-api-feature-xyz
            -->
            <plugin>
                <groupId>org.mule.tools.maven</groupId>
                <artifactId>mule-maven-plugin</artifactId>
                <version>${mule.maven.plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <!-- CloudHub 2.0 deployment block -->
                    <cloudhub2Deployment>
                        <!-- Connected App credentials from CI secrets -->
                        <connectedAppClientId>${anypoint.client.id}</connectedAppClientId>
                        <connectedAppClientSecret>${anypoint.client.secret}</connectedAppClientSecret>
                        <connectedAppGrantType>client_credentials</connectedAppGrantType>

                        <!-- Deployment target -->
                        <environment>${deploy.environment}</environment>
                        <target>${deploy.target}</target>
                        <applicationName>${app.name}</applicationName>

                        <!-- Mule runtime -->
                        <muleVersion>${deploy.runtime.version}</muleVersion>

                        <!-- Compute sizing -->
                        <replicas>${deploy.replicas}</replicas>
                        <vCores>${deploy.replica.size}</vCores>

                        <!-- Non-sensitive runtime application properties -->
                        <properties>
                            <http.port>8081</http.port>
                            <mule.env>${deploy.environment}</mule.env>
                        </properties>
                    </cloudhub2Deployment>
                </configuration>
            </plugin>

            <!--
              MUnit Maven Plugin
              Runs MUnit tests and generates HTML/JSON coverage reports
            -->
            <plugin>
                <groupId>com.mulesoft.munit.tools</groupId>
                <artifactId>munit-maven-plugin</artifactId>
                <version>${munit.version}</version>
                <executions>
                    <execution>
                        <id>test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                            <goal>coverage-report</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <coverage>
                        <runCoverage>true</runCoverage>
                        <!-- Set to true to enforce coverage gates -->
                        <failBuild>false</failBuild>
                        <requiredApplicationCoverage>0</requiredApplicationCoverage>
                        <requiredResourceCoverage>0</requiredResourceCoverage>
                        <requiredFlowCoverage>0</requiredFlowCoverage>
                        <formats>
                            <format>html</format>
                            <format>json</format>
                        </formats>
                    </coverage>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <!-- ==================== Repositories ==================== -->
    <repositories>
        <repository>
            <id>anypoint-exchange-v3</id>
            <name>Anypoint Exchange V3</name>
            <url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
            <layout>default</layout>
        </repository>
        <repository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository</name>
            <url>https://repository.mulesoft.org/releases/</url>
            <layout>default</layout>
        </repository>
        <repository>
            <id>mulesoft-snapshots</id>
            <name>MuleSoft Snapshots Repository</name>
            <url>https://repository.mulesoft.org/snapshots/</url>
            <layout>default</layout>
        </repository>
    </repositories>

    <!-- ==================== Plugin Repositories ==================== -->
    <pluginRepositories>
        <pluginRepository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Plugin Repository</name>
            <url>https://repository.mulesoft.org/releases/</url>
            <layout>default</layout>
        </pluginRepository>
        <pluginRepository>
            <id>mulesoft-snapshots</id>
            <name>MuleSoft Snapshots Plugin Repository</name>
            <url>https://repository.mulesoft.org/snapshots/</url>
            <layout>default</layout>
        </pluginRepository>
    </pluginRepositories>

</project>